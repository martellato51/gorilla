#!/bin/bash
#SBATCH --job-name=bfcl_v3_llada21_base_st
#SBATCH --partition=jobs
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:2
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=/home/ilju/bfcl_v3_llada21_base_st.%j.log
#SBATCH --error=/home/ilju/bfcl_v3_llada21_base_st.%j.log

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export BFCL_FUNCTION_DOC_SERIALIZATION=legacy
export BFCL_AST_DECODER=legacy
export TEST_CATEGORIES="${TEST_CATEGORIES:-simple,multiple,parallel,parallel_multiple,java,javascript,live_simple,live_multiple,live_parallel,live_parallel_multiple}"
export RUN_NAME="${RUN_NAME:-llada21_v3_baseline_st_${SLURM_JOB_ID:-$(date +%Y%m%d_%H%M%S)}}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-1,2}"

exec bash "${SCRIPT_DIR}/run_bfcl_llada2_1.job"
